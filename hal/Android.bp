package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "weaver_hal_defaults",
    edition: "2021",
    lints: "android",
    rustlibs: [
        "android.hardware.weaver-V2-rust",
        "libbinder_rs",
        "libciborium",
        "libciborium_io",
        "libweaver_wire",
        "libhal_wire",
        "libhal_hal",
        "liblog_rust",
    ],
    proc_macros: [
        "libhal_wire_derive",
    ],
}

rust_library {
    name: "libweaver_hal",
    crate_name: "weaver_hal",
    srcs: ["src/lib.rs"],
    vendor_available: true,
    defaults: [
        "weaver_hal_defaults",
    ],
}
